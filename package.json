{
  "name": "git-manager",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Gestor local de repositorios Git y GitLab (React + Node + Material UI)",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run build && npm start -w server",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 install",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 uninstall",
    "startup:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 start",
    "startup:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 stop",
    "startup:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 restart",
    "startup:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup/startup.ps1 status",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
